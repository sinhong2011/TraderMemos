node_modules/
web/dist/
api/data/
api/tmp/
api/.env
api/.env.local
*.db
*.db-*
.DS_Store
/data/
.superpowers/
.worktrees/
/tmp/
.pnpm-store/
web/.tanstack/

# Env files (keep committed *.example templates)
.env
.env.*
!.env.example
!**/.env.example

# Test / coverage / logs
coverage/
**/coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / local tooling (keep committed .vscode workspace tips)
.idea/
*.swp
*.swo

# Expo / mobile local
.expo/
mobile/.expo/
# Native projects are generated by `expo prebuild` (CNG) — never committed
mobile/ios/
mobile/android/
mobile/dist/

# visual verification artifacts
*.png
.playwright-mcp/
web/.playwright-mcp/

# shipped image assets are exempt from the artifact ignore
!brand/*.png
!brand/mobile/*.png
!web/public/*.png
# app icons / splash are build inputs, not verification artifacts
!mobile/assets/images/*.png
!mobile/assets/expo.icon/Assets/*.png
!web/src/assets/*.png
!docs/screenshots/*.png
# ...except the Expo starter-template art the exemption above lets back in
mobile/assets/images/expo-badge.png
mobile/assets/images/expo-badge-white.png
mobile/assets/images/expo-logo.png
mobile/assets/images/logo-glow.png
mobile/assets/images/react-logo*.png
mobile/assets/images/tutorial-web.png
mobile/assets/expo.icon/Assets/grid.png
.gstack/

# Python bytecode (scripts/)
__pycache__/
*.pyc

# Local scheduler state
.claude/scheduled_tasks.lock

# Per-machine agent/IDE scratch dropped into mobile/ by Blitz, Codex, OpenCode
mobile/.agents/
mobile/.blitz/
mobile/.claude/
mobile/.codex/
mobile/.mcp.json
mobile/CLAUDE.md
mobile/opencode.json
