    "@lingui/react": "^5.2.0",
    "@tanstack/react-form": "^1.33.1",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-router": "^1.95.0",
    "@tanstack/react-table": "^8.20.0",
    "@tanstack/react-virtual": "^3.11.0",
    "bignumber.js": "^11.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
