    "@testing-library/user-event": "^14.5.0",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^25.0.0",
    "serwist": "^9.5.11",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4"
