{
  "name": "tradermemos-web",
  "private": true,
  "workspaces": [
    "."
  ],
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b --noEmit && vp build",
    "preview": "vp preview",
    "deploy": "wrangler deploy",
    "test": "vp test run",
    "test:watch": "vp test",
    "e2e": "playwright test",
    "lint": "vp check",
    "fmt": "vp fmt",
    "check": "vp check",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile --typescript --namespace es"
  },
  "cloudflare": {
    "bindings": {
      "VITE_API": {
        "description": "Optional build-time API base URL (e.g. `https://api.example.com/api/v1`). Leave empty and set **Server** on the login screen instead. See [fork-deploy.md](https://github.com/sinhong2011/TraderMemos/blob/main/docs/fork-deploy.md)."
      }
    }
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
