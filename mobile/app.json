{
  "expo": {
    "name": "TraderMemos",
    "slug": "tradermemos",
    "version": "0.6.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "tradermemos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.tradermemos.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "en",
          "ja",
          "ko",
          "zh-Hant-HK"
        ],
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Broker screenshot",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.image"
            ]
          },
          {
            "CFBundleTypeName": "Fill file",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.comma-separated-values-text",
              "public.json",
              "public.plain-text"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.tradermemos.app",
      "adaptiveIcon": {
        "backgroundColor": "#0D6CEE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#161616"
          }
        }
      ],
      "expo-localization",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "TraderMemos reads the screenshots you pick to prefill trade entries.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-ios-scene-lifecycle",
      "./plugins/with-widgets",
      [
        "expo-calendar",
        {
          "calendarPermission": false,
          "remindersPermission": "TraderMemos adds your daily checklist and the economic releases you bookmark to your Reminders."
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a8bda1dd-0562-412f-ad9f-cc8834002930",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "TraderMemosWidgets",
                  "bundleIdentifier": "com.tradermemos.app.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.tradermemos.app"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "sinhong2011"
  }
}
