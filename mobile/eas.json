{
  "$schema": "https://raw.githubusercontent.com/expo/eas-cli/main/packages/eas-json/schema/eas.schema.json",
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "node": "25.6.1",
      "corepack": true,
      "env": {
        "EXPO_NO_TELEMETRY": "1"
      },
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "node": "25.6.1",
      "corepack": true,
      "env": {
        "EXPO_NO_TELEMETRY": "1"
      },
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "node": "25.6.1",
      "corepack": true,
      "env": {
        "EXPO_NO_TELEMETRY": "1"
      },
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6797427206",
        "appleTeamId": "FX3VR69P5K",
        "language": "en-US",
        "groups": ["Internal Testers"]
      }
    }
  }
}
