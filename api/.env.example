# ============================================================================
# TraderMemos API runtime configuration
# ----------------------------------------------------------------------------
# Copy to api/.env for local air/dev. Air loads this via env_files in .air.toml.
# All keys use the TM_ prefix (see api/internal/config).
# Unset vars fall back to the defaults below.
# ============================================================================

# --- Server -----------------------------------------------------------------
# TM_HTTP_PORT=8080
# TM_LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# SQLite path relative to the api/ working directory (air cwd).
# TM_DB_PATH=data/tradermemos.db

# --- Auth -------------------------------------------------------------------
# JWT signing secret. Change for anything beyond local throwaway use.
# Generate with: openssl rand -hex 32
TM_JWT_SECRET=dev-insecure-change-me

# --- Defaults ---------------------------------------------------------------
# TM_DEFAULT_CURRENCY=USD

# --- Upload limits (bytes) --------------------------------------------------
# TM_ATTACH_MAX_BYTES=10485760
# TM_IMPORT_MAX_BYTES=10485760
