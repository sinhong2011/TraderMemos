# ============================================================================
# TraderMemos API runtime configuration
# ----------------------------------------------------------------------------
# Copy to api/.env for local air/dev. Air loads this via env_files in .air.toml.
# All keys use the TM_ prefix (see api/internal/config).
# Unset vars fall back to the defaults below.
# ============================================================================

# --- Server -----------------------------------------------------------------
# TM_HTTP_PORT=8080
# TM_LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# Unified URL (preferred). SQLite or Postgres — pick one.
# TM_DATABASE_URL=sqlite:data/tradermemos.db
# TM_DATABASE_URL=sqlite:///data/tradermemos.db
# TM_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Legacy alias (converted to sqlite:… if TM_DATABASE_URL is unset):
# TM_DB_PATH=data/tradermemos.db
# For Postgres, set attachment dir explicitly (no sibling DB file):
# TM_ATTACH_DIR=data/attachments

# --- Auth -------------------------------------------------------------------
# JWT signing secret. REQUIRED for production (min 32 chars).
# Generate with: openssl rand -hex 32
TM_JWT_SECRET=dev-insecure-change-me
# Local/dev only — allows the insecure default above. Never enable in production.
TM_ALLOW_INSECURE_JWT=true
# After first-user setup, open registration stays closed unless you opt in.
# TM_ALLOW_REGISTRATION=false
# TM_ALLOW_REGISTRATION=true

# --- Defaults ---------------------------------------------------------------
# TM_DEFAULT_CURRENCY=USD

# --- Attachments / note media -----------------------------------------------
# Disk store for trade screenshots + TipTap note images (default: <dbDir>/attachments).
# Back this directory up with the SQLite DB — export ZIP also includes trade files.
# TM_ATTACH_DIR=
# TM_ATTACH_MAX_BYTES=10485760
# TM_IMPORT_MAX_BYTES=10485760

# --- CORS (split hosting) ---------------------------------------------------
# Comma-separated browser origins allowed to call this API cross-origin.
# Leave unset for same-origin Docker / reverse-proxy (recommended default).
# Exact:  https://app.example.com
# Wildcard subdomain: https://*.vercel.app  https://*.pages.dev
# Example for CDN web + Railway/Docker API:
# TM_CORS_ORIGINS=https://*.vercel.app,https://*.pages.dev,https://*.workers.dev,https://*.netlify.app,https://*.up.railway.app,http://localhost:5173
# TM_CORS_ORIGINS=

# --- OCR / screenshot parse (LLM vision) ------------------------------------
# Prefer Settings → AI → Screenshot scan in the web UI.
# Env values are defaults until saved in the UI (DB wins after first save).
# TM_OCR_ENABLED=false
# TM_OCR_MAX_BYTES=10485760
# TM_OCR_VISION_BASE_URL=https://api.openai.com/v1
# TM_OCR_VISION_API_KEY=
# TM_OCR_VISION_MODEL=gpt-4o-mini
# TM_OCR_VISION_TIMEOUT_SEC=90

# --- AI coach (LLM) ---------------------------------------------------------
# Prefer Settings → AI → Coach in the web UI.
# TM_COACH_ENABLED=false
# TM_COACH_BASE_URL=https://api.openai.com/v1
# TM_COACH_API_KEY=
# TM_COACH_MODEL=gpt-4o-mini

# --- Public share pages -----------------------------------------------------
# Revocable read-only performance links (/s/<token>). Off by default: the
# public endpoint exposes journal aggregates without auth.
# TM_SHARE_LINKS_ENABLED=false
