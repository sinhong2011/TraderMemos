# Copied by Compose for variable substitution (docker compose up).
#   cp .env.example .env
#
# --- Docker Hub images (default compose pulls these) ---
# Namespace that owns tradermemos-api / tradermemos-web on Hub.
# Official images: sinhong2011. Forks that publish their own builds: your Hub username.
DOCKERHUB_USERNAME=sinhong2011
# Tag to pull (latest, or a release like 0.1.1). Prefer pinning in production.
TM_IMAGE_TAG=latest

# --- App (same keys as docker-compose.yml) ---
# TM_JWT_SECRET=          # openssl rand -hex 32  (required in production)
# TM_ALLOW_INSECURE_JWT=false
# TM_ALLOW_REGISTRATION=false
# TM_DATABASE_URL=sqlite:///data/tradermemos.db
# TM_CORS_ORIGINS=
